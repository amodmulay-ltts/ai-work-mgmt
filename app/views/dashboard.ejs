<% if (!me || errors.name || errors.email) { %>
<div class="page-header">
  <h1>Dashboard</h1>
</div>
  <section class="card first-run">
    <h2>Welcome — tell us who you are</h2>
    <p class="muted">Your name is used as the presales owner for new opportunities. You can change it later in Settings.</p>
    <form method="post" action="/setup" novalidate>
      <div class="field">
        <label for="name">Your name <span class="req" aria-hidden="true">*</span></label>
        <input id="name" name="name" type="text" required value="<%= values.name || '' %>"
               <%- errors.name ? 'aria-invalid="true" aria-describedby="name-error"' : '' %>>
        <% if (errors.name) { %><p class="error" id="name-error"><%= errors.name %></p><% } %>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" value="<%= values.email || '' %>"
               <%- errors.email ? 'aria-invalid="true" aria-describedby="email-error"' : '' %>>
        <% if (errors.email) { %><p class="error" id="email-error"><%= errors.email %></p><% } %>
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">Save</button>
      </div>
    </form>
  </section>
<% } else { %>
<%
  const k = view.kpi;
  const wt = Object.entries(k.weighted);
  const pl = Object.entries(k.pipeline);
  const maxStage = Math.max(1, ...view.pipeline.map((s) => s.count));
  const maxAge = Math.max(1, ...Object.values(view.aging));
%>
<%- include('partials/tag-filter', { all: cfg.tags, tags, base: '/', query: tagQuery }) %>
<div class="page-header dash-head">
  <h1><%= greeting %>, <%= firstName %></h1>
  <form method="get" action="/opportunities" class="dash-search" role="search">
    <input type="search" name="q" placeholder="Search opportunities…" aria-label="Search opportunities" class="search">
  </form>
  <div class="page-actions">
    <a class="btn btn-secondary" href="/report/weekly">Weekly report</a>
    <a class="btn btn-secondary" href="/export/opportunities.xlsx">Export to Excel</a>
    <a class="btn btn-secondary" href="/export/pipeline">Export pipeline</a>
    <form method="post" action="/sync" class="inline"><button class="btn btn-secondary" type="submit">Sync now</button></form>
  </div>
</div>

<div class="kpi-grid">
  <div class="card kpi">
    <div class="kpi-label">Open opportunities</div>
    <div class="kpi-value"><%= k.open %></div>
    <div class="kpi-sub"><%= k.onHold %> on hold</div>
  </div>
  <div class="card kpi">
    <div class="kpi-label">Pipeline</div>
    <div class="kpi-value kpi-money">
      <% if (pl.length === 0) { %>—<% } %>
      <% for (const [currency, amount] of pl.slice(0, 4)) { %><div><%= moneyCompact(amount, currency) %></div><% } %>
      <% if (pl.length > 4) { %><div class="kpi-sub">+<%= pl.length - 4 %> more</div><% } %>
    </div>
    <div class="kpi-sub">estimated value · open opportunities</div>
  </div>
  <div class="card kpi">
    <div class="kpi-label">Weighted pipeline</div>
    <div class="kpi-value kpi-money">
      <% if (wt.length === 0) { %>—<% } %>
      <% for (const [currency, amount] of wt.slice(0, 4)) { %><div><%= moneyCompact(amount, currency) %></div><% } %>
      <% if (wt.length > 4) { %><div class="kpi-sub">+<%= wt.length - 4 %> more</div><% } %>
    </div>
    <div class="kpi-sub">weighted · open opportunities</div>
  </div>
  <div class="card kpi">
    <div class="kpi-label">Won to date</div>
    <div class="kpi-value kpi-money">
      <% if (k.won.count === 0) { %>—<% } %>
      <% for (const [currency, amount] of Object.entries(k.won.totals).slice(0, 4)) { %><div><%= moneyCompact(amount, currency) %></div><% } %>
    </div>
    <div class="kpi-sub"><%= k.won.count %> won</div>
  </div>
</div>

<%
  const sub = view.submissions;
  const maxSub = Math.max(1, ...sub.months.map((m) => m.count));
  const maxBu = Math.max(1, ...view.byBu.map((b) => b.count));
%>
<div class="chart-grid chart-grid-two">
  <section class="card chart-card">
    <h2>Open opportunities by BU</h2>
    <% if (view.byBu.length === 0) { %>
      <p class="subtle">No open opportunities.</p>
    <% } %>
    <% for (const b of view.byBu) { %>
      <a class="bar-row" href="/opportunities?bu=<%= encodeURIComponent(b.bu === 'No BU' ? 'none' : b.bu) %>" title="<%= b.bu %>: <%= b.count %> open · see them">
        <span class="bar-label"><%= b.bu %></span>
        <span class="bar-track"><span class="bar-fill" style="width: <%= Math.round((b.count / maxBu) * 100) %>%"></span></span>
        <span class="bar-value"><%= b.count %> · <%= moneyTotalsText(b.totals) %></span>
      </a>
    <% } %>
  </section>

  <section class="card chart-card">
    <h2>Open opportunities by customer</h2>
    <% if (view.byCustomer.length === 0) { %>
      <p class="subtle">No open opportunities.</p>
    <% } %>
    <%
      const topCustomers = view.byCustomer.slice(0, 8);
      const maxCustomer = Math.max(1, ...topCustomers.map((c) => c.count));
    %>
    <% for (const c of topCustomers) { %>
      <a class="bar-row" href="/opportunities?customer=<%= c.customerId %>" title="<%= c.customer %>: <%= c.count %> open · see them">
        <span class="bar-label"><%= c.customer %></span>
        <span class="bar-track"><span class="bar-fill" style="width: <%= Math.round((c.count / maxCustomer) * 100) %>%"></span></span>
        <span class="bar-value"><%= c.count %> · <%= moneyTotalsText(c.totals) %></span>
      </a>
    <% } %>
    <% if (view.byCustomer.length > 8) { %>
      <p class="card-foot muted">+<%= view.byCustomer.length - 8 %> more customers</p>
    <% } %>
  </section>
</div>

<div class="dash-grid dash-grid-one">
<section class="card next-actions-card">
  <h2>My next actions</h2>
  <% if (view.actions.length === 0) { %>
    <p class="subtle">No open opportunities have you as presales owner yet.</p>
  <% } %>
  <div class="scroll-list">
  <ul class="action-list">
    <% for (const r of view.actions) { const d = r.deal; %>
      <li class="action">
        <div class="action-main">
          <div>
            <a href="/opportunities/<%= d.id %>"><%= d.title %></a>
            <span class="mono subtle"><%= d.id %></span>
          </div>
          <div class="muted">
            <%= d.next_action || 'No next action set' %>
            <% if (d.next_action_due) { %> · <%= fmtDate(d.next_action_due) %> (<%= relDays(d.next_action_due, today) %>)<% } %>
          </div>
        </div>
        <div class="action-buttons">
          <% if (d.next_action) { %>
            <form method="post" action="/opportunities/<%= d.id %>/next-action/done" class="inline">
              <button class="btn btn-secondary btn-sm" type="submit" aria-label="Mark done: <%= d.next_action %>">Done</button>
            </form>
          <% } %>
          <button type="button" class="btn btn-ghost btn-sm" data-reveal="na-<%= d.id %>" aria-expanded="false" aria-controls="na-<%= d.id %>" aria-label="Edit next action for <%= d.title %>">Edit</button>
          <% if (d.next_action) { %>
            <button type="button" class="btn btn-ghost btn-sm" data-reveal="cl-<%= d.id %>" aria-expanded="false" aria-controls="cl-<%= d.id %>" aria-label="Cancel or postpone next action for <%= d.title %>">Cancel or postpone</button>
          <% } %>
        </div>
        <form method="post" action="/opportunities/<%= d.id %>/next-action" class="reveal-form" id="na-<%= d.id %>" hidden>
          <input type="text" name="next_action" value="<%= d.next_action || '' %>" placeholder="What happens next" aria-label="Next action">
          <input type="date" name="next_action_due" value="<%= d.next_action_due || '' %>" aria-label="Due">
          <button class="btn btn-primary btn-sm" type="submit">Save</button>
        </form>
        <form method="post" action="/opportunities/<%= d.id %>/next-action/close" class="reveal-form" id="cl-<%= d.id %>" hidden>
          <select name="status" aria-label="Cancelled or postponed">
            <option value="cancelled">Cancelled</option>
            <option value="postponed">Postponed</option>
          </select>
          <input type="text" name="reason" required placeholder="Reason" aria-label="Reason">
          <button class="btn btn-primary btn-sm" type="submit">Save</button>
        </form>
      </li>
    <% } %>
  </ul>
  </div>
</section>

</div>


<div class="dash-grid">
  <section class="card table-card">
    <h2 class="card-pad">Upcoming visits</h2>
    <% if (view.visits.upcoming.length === 0) { %>
      <p class="subtle">No planned visits. Plan one on the <a href="/visits">Visits</a> page.</p>
    <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Date</th>
              <th scope="col">Customer</th>
              <th scope="col">Visit</th>
              <th scope="col">Sales lead</th>
              <th scope="col">Who we meet</th>
            </tr>
          </thead>
          <tbody>
            <% for (const v of view.visits.upcoming) { %>
              <tr class="clickable" data-href="/customers/<%= v.customerId %>">
                <td><%= fmtDate(v.on) %></td>
                <td><a href="/customers/<%= v.customerId %>"><%= v.customer %></a></td>
                <td><%= v.kind %></td>
                <td><%= v.whoName %></td>
                <td><%= v.with || '—' %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
    <p class="card-foot"><a href="/visits?status=Planned">All planned visits →</a></p>
  </section>

  <section class="card">
    <h2>Visits</h2>
    <div class="visit-counts">
      <a href="/visits?status=Done">
        <span class="visit-total"><%= view.visits.completed.total %></span>
        <span class="kpi-sub">completed · <%= view.visits.completed.inYear %> this year</span>
      </a>
      <a href="/visits?status=Planned">
        <span class="visit-total"><%= view.visits.planned %></span>
        <span class="kpi-sub">planned</span>
      </a>
      <a href="/visits?status=Cancelled">
        <span class="visit-total"><%= view.visits.cancelled %></span>
        <span class="kpi-sub">cancelled</span>
      </a>
    </div>
    <p class="card-foot"><a href="/visits">All visits →</a></p>
  </section>
</div>

<section class="card table-card">
  <h2 class="card-pad">Internal activities</h2>
  <p class="card-pad muted">
    <% for (const s of Object.keys(view.activities.counts)) { %><%= s %> <%= view.activities.counts[s] %><% if (s !== 'Stopped') { %> · <% } %><% } %>
  </p>
  <% if (view.activities.inProgress.length === 0) { %>
    <p class="subtle">Nothing in progress. Add a prototype or concept from <a href="/activities">Activities</a>.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">ID</th>
            <th scope="col">Title</th>
            <th scope="col">Kind</th>
            <th scope="col">Owner</th>
            <th scope="col">Last update</th>
          </tr>
        </thead>
        <tbody>
          <% for (const r of view.activities.inProgress) { %>
            <tr class="clickable" data-href="/activities/<%= r.activity.id %>">
              <td class="mono"><a href="/activities/<%= r.activity.id %>"><%= r.activity.id %></a></td>
              <td class="ellipsis"><%= r.activity.title %></td>
              <td><%= r.activity.kind %></td>
              <td><%= r.owner %></td>
              <td class="<%= r.quiet ? 'text-red' : '' %>"><%= fmtDate(r.last) %><% if (r.quiet) { %> · quiet <%= r.days %> days<% } %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="card table-card">
  <h2 class="card-pad">Recently updated</h2>
  <%- include('partials/deal-table', { rows: view.recent, cfg, today, withCustomer: true, empty: 'No opportunities yet.', extra: [{ header: 'Last updated', cell: (r) => fmtDate(r.deal.updated_at.slice(0, 10)) }, { header: 'Next step', cell: (r) => r.deal.next_action ? `<div class="ellipsis">${ui.esc(r.deal.next_action)}</div>${r.deal.next_action_due ? `<span class="rel">${fmtDate(r.deal.next_action_due)}</span>` : ''}` : '<span class="subtle">Not set</span>' }] }) %>
</section>

<div class="dash-grid dash-grid-one">
  <section class="card table-card">
    <h2 class="card-pad">Needs attention</h2>
    <% if (view.attention.length === 0) { %>
      <p class="subtle">Nothing needs attention right now.</p>
    <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th scope="col" class="c-health"><span class="sr-only">Health</span></th>
              <th scope="col">ID</th>
              <th scope="col">Title</th>
              <th scope="col">Customer</th>
              <th scope="col">Why</th>
            </tr>
          </thead>
          <tbody>
            <% for (const r of view.attention) { %>
              <tr class="clickable" data-href="/opportunities/<%= r.deal.id %>">
                <td class="c-health"><%- ui.healthDot(r.health) %></td>
                <td class="mono"><a href="/opportunities/<%= r.deal.id %>"><%= r.deal.id %></a></td>
                <td class="ellipsis" title="<%= r.deal.title %>"><%= r.deal.title %></td>
                <td class="ellipsis"><%= r.customerName %></td>
                <td class="ellipsis" title="<%= r.health.reasons.join(' · ') %>"><%= r.health.reasons[0] %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
    <p class="card-foot"><a href="/opportunities">All opportunities →</a></p>
  </section>

</div>

<div class="dash-grid">
  <section class="card">
    <h2>Pipeline by stage</h2>
    <% for (const s of view.pipeline) { %>
      <div class="bar-row">
        <span class="bar-label"><%= s.stage %></span>
        <span class="bar-track"><span class="bar-fill" style="width: <%= Math.round((s.count / maxStage) * 100) %>%"></span></span>
        <span class="bar-value"><%= s.count %> · <%= moneyTotalsText(s.totals) %></span>
      </div>
    <% } %>
  </section>
  <section class="card">
    <h2>Aging of open opportunities</h2>
    <% for (const [bucket, count] of Object.entries(view.aging)) { %>
      <div class="bar-row">
        <span class="bar-label">Age <%= bucket %> days</span>
        <span class="bar-track"><span class="bar-fill" style="width: <%= Math.round((count / maxAge) * 100) %>%"></span></span>
        <span class="bar-value"><%= count %></span>
      </div>
    <% } %>
  </section>
</div>

<section class="card table-card">
  <h2 class="card-pad">Customers to connect with</h2>
  <% if (view.connectFlags.length === 0) { %>
    <p class="subtle">Every customer with open work has been connected with recently.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Customer</th>
            <th scope="col" class="num">Open opportunities</th>
            <th scope="col">Last connected</th>
          </tr>
        </thead>
        <tbody>
          <% for (const r of view.connectFlags) { %>
            <tr class="clickable" data-href="/customers/<%= r.customer.id %>">
              <td><a href="/customers/<%= r.customer.id %>"><%= r.customer.name %></a></td>
              <td class="num"><%= r.openCount %></td>
              <td class="text-red"><%= r.connect.text %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<div class="chart-grid chart-grid-one">
  <section class="card chart-card">
    <h2>Submissions due, next 6 months</h2>
    <div class="col-chart" role="img" aria-label="<%= sub.months.map((m) => m.label + ' ' + m.count).join(', ') %>">
      <% for (const m of sub.months) { %>
        <a class="col" href="/opportunities?submit_month=<%= m.key %>" title="<%= m.label %>: <%= m.count %> due · see them">
          <span class="col-value"><%= m.count %></span>
          <span class="col-bar" style="height: <%= Math.round((m.count / maxSub) * 80) %>%"></span>
        </a>
      <% } %>
    </div>
    <div class="col-labels" aria-hidden="true">
      <% for (const m of sub.months) { %><span><%= m.label %></span><% } %>
    </div>
    <p class="card-foot <%= sub.overdue ? 'text-red' : 'muted' %>"><%= sub.overdue %> overdue · <%= sub.later %> later</p>
  </section>
</div>

<div class="dash-grid dash-grid-one">
<section class="card asks-card">
    <h2>Asks for me</h2>
    <p class="muted"><%= view.myAsks.dueWeek %> due this week, including overdue</p>
    <% if (view.myAsks.rows.length === 0) { %>
      <p class="subtle">No open asks for you.</p>
    <% } %>
    <ul class="action-list">
      <% for (const r of view.myAsks.rows) { %>
        <li class="action">
          <div class="action-main">
            <div>
              <a href="/opportunities/<%= r.deal.id %>#support"><%= r.ask.text %></a>
              <span class="mono subtle"><%= r.deal.id %></span>
            </div>
            <div class="muted">
              <%= r.deal.title %> ·
              <% if (r.ask.due_on) { %><%= fmtDate(r.ask.due_on) %> (<%= relDays(r.ask.due_on, today) %>)<% } else { %>No due date<% } %>
            </div>
          </div>
        </li>
      <% } %>
    </ul>
    <p class="card-foot"><a href="/support/asks">All my asks (<%= view.myAsks.total %>) →</a></p>
  </section>
</div>

<% } %>
