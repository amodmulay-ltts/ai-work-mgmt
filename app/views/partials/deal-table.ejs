<%
  // Optional extra columns: [{ header, cell(row) }]. cell returns HTML. Only the support page uses them.
  const extraCols = typeof extra === 'undefined' ? [] : extra;
%>
<% if (rows.length === 0) { %>
  <p class="subtle"><%= empty %></p>
<% } else { %>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th scope="col" class="c-health"><span class="sr-only">Health</span></th>
          <th scope="col">ID</th>
          <th scope="col">Title</th>
          <th scope="col">Stage</th>
          <th scope="col">Submission due</th>
          <th scope="col" class="num">Value</th>
          <% for (const col of extraCols) { %><th scope="col"><%= col.header %></th><% } %>
        </tr>
      </thead>
      <tbody>
        <% for (const r of rows) { const d = r.deal; %>
          <tr class="clickable" data-href="/opportunities/<%= d.id %>">
            <td class="c-health"><%- ui.healthDot(r.health) %></td>
            <td class="mono"><a href="/opportunities/<%= d.id %>"><%= d.id %></a></td>
            <td class="ellipsis" title="<%= d.title %>"><%= d.title %></td>
            <td><%- ui.stageBadge(d.stage, cfg) %></td>
            <td><%- ui.dueCell(d.submission_due, today, { done: d.submitted_on }) %></td>
            <td class="num"><%= moneyCompact(d.est_value, d.currency) %></td>
            <% for (const col of extraCols) { %><td><%- col.cell(r) %></td><% } %>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
<% } %>
