<div class="page-header">
  <h1>Wins by year</h1>
</div>

<p class="muted">Won and lost opportunities by the year they closed. Dropped ones are not counted as losses. Add an older win by setting its Closed on date.</p>

<section class="card wins-card">
  <% if (wins.years.length === 0) { %>
    <p class="subtle">No closed opportunities yet. Won and lost opportunities appear here by the year they closed.</p>
  <% } else { %>
    <%
      const yrs = wins.years;
      const maxWon = Math.max(1, ...yrs.map((y) => y.won));
    %>
    <div class="col-chart" role="img" aria-label="<%= yrs.map((y) => y.year + ' ' + y.won + ' won').join(', ') %>">
      <% for (const y of yrs) { %>
        <div class="col" title="<%= y.year %>: <%= y.won %> won, <%= y.lost %> lost">
          <span class="col-value"><%= y.won %></span>
          <span class="col-bar" style="height: <%= Math.round((y.won / maxWon) * 80) %>%"></span>
        </div>
      <% } %>
    </div>
    <div class="col-labels" aria-hidden="true">
      <% for (const y of yrs) { %><span><%= y.year %></span><% } %>
    </div>
    <div class="table-wrap wins-table">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Year</th>
            <th scope="col" class="num">Won</th>
            <th scope="col" class="num">Lost</th>
            <th scope="col" class="num">Win rate</th>
            <th scope="col">Won value</th>
          </tr>
        </thead>
        <tbody>
          <% for (const y of [...yrs].reverse()) { %>
            <tr>
              <td><%= y.year %></td>
              <td class="num"><%= y.won %></td>
              <td class="num"><%= y.lost %></td>
              <td class="num"><%= y.rate === null ? '—' : Math.round(y.rate * 100) + '%' %></td>
              <td><%= moneyTotalsText(y.wonTotals) %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% if (wins.undated.won || wins.undated.lost) { %>
      <p class="card-foot muted"><%= wins.undated.won %> won and <%= wins.undated.lost %> lost have no closed date, so they are not in any year. Add the closed date on the opportunity to count them.</p>
    <% } %>
  <% } %>
</section>
