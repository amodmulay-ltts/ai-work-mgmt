<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? title + ' · ' : '' %>Work Tracker</title>
  <meta name="theme-color" content="#1D4ED8">
  <link rel="manifest" href="/static/manifest.webmanifest">
  <link rel="icon" href="/static/icon-192.png" type="image/png">
  <link rel="stylesheet" href="/static/app.css">
</head>
<body>
  <header class="topnav">
    <div class="topnav-inner">
      <a class="brand" href="/">Work Tracker</a>
      <nav class="navlinks" aria-label="Main">
        <a href="/" class="<%= active === 'dashboard' ? 'active' : '' %>">Dashboard</a>
        <a href="/opportunities" class="<%= active === 'deals' ? 'active' : '' %>">Opportunities</a>
        <a href="/support" class="<%= active === 'support' ? 'active' : '' %>">Support</a>
        <a href="/support/asks" class="<%= active === 'asks' ? 'active' : '' %>">My asks</a>
        <a href="/customers" class="<%= active === 'customers' ? 'active' : '' %>">Customers</a>
        <a href="/people" class="<%= active === 'people' ? 'active' : '' %>">People</a>
        <a href="/activities" class="<%= active === 'activities' ? 'active' : '' %>">Activities</a>
        <a href="/wins" class="<%= active === 'wins' ? 'active' : '' %>">Wins</a>
        <a href="/settings" class="<%= active === 'settings' ? 'active' : '' %>">Settings</a>
      </nav>
      <div class="topnav-right">
        <a class="btn btn-primary btn-sm" href="/opportunities/new">+ New opportunity</a>
        <form id="sync-form" method="post" action="/sync"></form>
        <button id="sync-badge" class="sync-badge" type="submit" form="sync-form"
                data-state="<%= sync.state %>" title="<%= sync.lastError || '' %>">
          <span class="dot" aria-hidden="true"></span>
          <span class="label"><%= syncLabel(sync) %></span>
        </button>
      </div>
    </div>
  </header>

  <% if (sync.state === 'error') { %>
    <div class="banner banner-error" role="alert">
      Last sync failed: <%= sync.lastError %>. Your changes are saved on this computer and will be pushed when the connection works.
    </div>
  <% } %>

  <% if (conflictCount) { %>
    <div class="banner banner-warning" role="status">
      <%= conflictCount %> sync conflict<%= conflictCount === 1 ? '' : 's' %> need<%= conflictCount === 1 ? 's' : '' %> a decision. <a href="/conflicts">Review conflicts</a>
    </div>
  <% } %>
  <% if (problemCount) { %>
    <div class="banner banner-error" role="alert">
      <%= problemCount %> data file<%= problemCount === 1 ? '' : 's' %> could not be read. <a href="/settings#problems">See Settings</a>
    </div>
  <% } %>
  <% if (lockWarning) { %>
    <div class="banner banner-warning" role="status"><%= lockWarning %></div>
  <% } %>

  <% if (flash) { %>
    <div class="toast toast-<%= flash.kind %>" role="status">
      <span><%= flash.text %></span>
      <button type="button" class="toast-close" aria-label="Close message">×</button>
    </div>
  <% } %>

  <main class="container">
    <%- body %>
  </main>

  <script src="/static/app.js"></script>
</body>
</html>
