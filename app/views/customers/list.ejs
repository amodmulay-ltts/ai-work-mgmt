<div class="page-header">
  <h1>Customers <span class="count"><%= rows.length %></span></h1>
  <div class="page-actions">
    <a class="btn btn-primary" href="/customers/new">+ New customer</a>
  </div>
</div>

<form method="get" action="/customers" class="filters" role="search">
  <input type="search" name="q" value="<%= q %>" placeholder="Search customers…" aria-label="Search customers" class="search">
  <button class="btn btn-secondary btn-sm" type="submit">Search</button>
  <% if (searching) { %><a href="/customers" class="btn btn-ghost">Clear</a><% } %>
</form>

<section class="card table-card">
  <% if (rows.length === 0 && searching) { %>
    <div class="empty-state">
      <h2>No customers match "<%= q %>"</h2>
      <p class="muted">Try fewer words, or <a href="/customers">show all customers</a>.</p>
    </div>
  <% } else if (rows.length === 0) { %>
    <div class="empty-state">
      <h2>No customers yet</h2>
      <p class="muted">Customers are created automatically when you name one on an opportunity, or you can add one now.</p>
      <a class="btn btn-primary" href="/customers/new">+ New customer</a>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Region</th>
            <th scope="col">Industry</th>
            <th scope="col">Account manager</th>
            <th scope="col" class="num">Open opportunities</th>
            <th scope="col" class="num">Open pipeline</th>
            <th scope="col">Last activity</th>
            <th scope="col">First connected</th>
            <th scope="col">Last connected</th>
          </tr>
        </thead>
        <tbody>
          <% for (const r of rows) { %>
            <tr class="clickable" data-href="/customers/<%= r.customer.id %>">
              <td><a href="/customers/<%= r.customer.id %>"><%= r.customer.name %></a></td>
              <td><%= r.customer.region || '—' %></td>
              <td><%= r.customer.industry || '—' %></td>
              <td><%= r.accountManager %></td>
              <td class="num"><%= r.openCount %></td>
              <td class="num"><%= moneyTotalsText(r.openTotals) %></td>
              <td><%= r.lastActivity ? fmtDate(r.lastActivity.slice(0, 10)) : '—' %></td>
              <td><%= r.connects.first ? fmtDate(r.connects.first) : '—' %></td>
              <td class="<%= r.connect.flagged ? 'text-red' : '' %>"><%= r.connect.text %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
