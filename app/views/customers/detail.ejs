<div class="page-header deal-head">
  <div>
    <h1><%= customer.name %></h1>
    <p class="muted meta-line">
      <% if (customer.region) { %><%= customer.region %><% } %>
      <% if (customer.industry) { %> · <%= customer.industry %><% } %>
      <% if (accountManager) { %> · Account manager: <%= accountManager %><% } %>
      <% if (customer.c4c_account_id) { %> · C4C account <span class="mono"><%= customer.c4c_account_id %></span> <button type="button" class="btn btn-ghost btn-sm" data-copy="<%= customer.c4c_account_id %>">Copy</button><% } %>
    </p>
  </div>
  <div class="page-actions">
    <a class="btn btn-primary" href="/opportunities/new?customer=<%= customer.id %>">+ New opportunity for this customer</a>
    <a class="btn btn-secondary" href="/customers/<%= customer.id %>/edit">Edit</a>
    <%- include('../partials/delete-form', { action: `/customers/${customer.id}/delete`, expected: customer.name, key: customer.id, what: 'customer' }) %>
  </div>
</div>

<div class="detail-grid">
  <div class="detail-main">
    <section class="card">
      <h2>Connections</h2>
      <p class="<%= connect.flagged ? 'text-red' : 'muted' %>">
        <% if (connects.length) { %>
          First connected <%= fmtDate(connects.at(-1).on) %> · last connected <%= fmtDate(connects[0].on) %> (<%= connect.text %>)
        <% } else { %>
          Never connected. Log a Teams meeting or a visit below.
        <% } %>
      </p>
      <p class="muted">
        Visits: <%= visits.total %> completed (<%= visits.inYear %> this year)<% if (planned.length) { %> · <%= planned.length %> planned<% } %>
      </p>
      <% if (planned.length) { %>
        <h3>Upcoming</h3>
        <ul class="plain-list">
          <% for (const c of planned) { %>
            <li><%= fmtDate(c.on) %> · <%= c.kind %> · <%= c.whoName %><% if (c.with) { %> with <%= c.with %><% } %></li>
          <% } %>
        </ul>
      <% } %>
      <% if (connects.length) { %>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th scope="col">Date</th>
                <th scope="col">Kind</th>
                <th scope="col">Status</th>
                <th scope="col">Our person</th>
                <th scope="col">Met</th>
                <th scope="col">Note</th>
                <th scope="col"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              <% for (const c of connects) { %>
                <tr>
                  <td><%= fmtDate(c.on) %></td>
                  <td><%= c.kind %></td>
                  <td><%= c.status ?? 'Done' %></td>
                  <td><%= c.whoName %></td>
                  <td><%= c.with || '—' %></td>
                  <td class="ellipsis" title="<%= c.note %>"><%= c.note || '—' %></td>
                  <td class="row-actions">
                    <% if ((c.status ?? 'Done') === 'Planned') { %>
                      <form method="post" action="/customers/<%= customer.id %>/connects/<%= c.id %>/done" class="inline">
                        <button class="btn btn-ghost btn-sm" type="submit">Mark done</button>
                      </form>
                    <% } %>
                    <form method="post" action="/customers/<%= customer.id %>/connects/<%= c.id %>/delete" class="inline" data-confirm="Remove this connect?">
                      <button class="btn btn-ghost btn-sm" type="submit">Remove</button>
                    </form>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      <% } %>
      <form method="post" action="/customers/<%= customer.id %>/connects" class="ask-form">
        <div class="field">
          <label for="connect-on">Date</label>
          <input type="date" id="connect-on" name="on" required value="<%= today %>">
        </div>
        <div class="field">
          <label for="connect-kind">Kind</label>
          <select id="connect-kind" name="kind" required>
            <option value="Teams">Teams</option>
            <option value="EI center visit">Visit to the EI centre</option>
            <option value="Customer premises visit">Visit to customer premises</option>
          </select>
        </div>
        <div class="field">
          <label for="connect-status">Status</label>
          <select id="connect-status" name="status">
            <option value="Done">Done</option>
            <option value="Planned">Planned</option>
          </select>
        </div>
        <div class="field">
          <label for="connect-who">Our person</label>
          <select id="connect-who" name="who_id">
            <option value="">Unassigned</option>
            <% for (const p of people) { %><option value="<%= p.id %>"><%= p.name %></option><% } %>
          </select>
        </div>
        <div class="field">
          <label for="connect-with">Who we met</label>
          <input type="text" id="connect-with" name="with" maxlength="100">
        </div>
        <div class="field field-wide">
          <label for="connect-note">Note</label>
          <input type="text" id="connect-note" name="note" maxlength="500">
        </div>
        <button class="btn btn-primary btn-sm" type="submit">Log connect</button>
      </form>
    </section>
    <section class="card">
      <h2>Open opportunities</h2>
      <%- include('../partials/deal-table', { rows: openRows, cfg, today, empty: 'No open opportunities for this customer.' }) %>
    </section>
    <section class="card">
      <h2>Closed opportunities</h2>
      <%- include('../partials/deal-table', { rows: closedRows, cfg, today, empty: 'No closed opportunities yet.' }) %>
    </section>
  </div>
  <aside class="detail-side">
    <section class="card">
      <h2>Contacts</h2>
      <% if (contacts.length === 0) { %><p class="subtle">No contacts yet. Add them on an opportunity, or on the People page.</p><% } %>
      <ul class="plain-list">
        <% for (const p of contacts) { %>
          <li>
            <strong><%= p.name %></strong><% if (p.title) { %> · <%= p.title %><% } %>
            <% if (p.email) { %><div class="muted"><a href="mailto:<%= p.email %>"><%= p.email %></a></div><% } %>
          </li>
        <% } %>
      </ul>
    </section>
    <section class="card">
      <h2>Notes</h2>
      <% if (customer.notes) { %><div class="note"><%= customer.notes %></div><% } else { %><p class="subtle">No notes.</p><% } %>
    </section>
  </aside>
</div>
